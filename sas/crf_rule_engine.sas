/* =========================================================================
   crf_rule_engine.sas  -  pure SAS version of the rule engine

   Reads the rules sheet (one row per CRF field) and WRITES the SAS program
   that types the raw scanner export and runs every plausibility rule.
   Data managers only maintain the Excel sheet; nobody edits SAS code.

   Steps:
     %crf_rules_to_sas(rules=, sheet=, code=)   Excel -> generated .sas file
     %include "&code.";                          defines %crf_clean
     %crf_clean(raw=, outlib=, outdir=)          runs the checks

   Expected sheet columns: variable | format | rule | message
   (question and coding are optional documentation columns).
   The raw export must list the fields in the same order as the sheet.

   Requires SAS 9.4M3 or later (PROC IMPORT DBMS=XLSX, ODS EXCEL).
   The Python package in this repo produces the same program with
   `crf-rules gen-sas` and is covered by tests; this file is the SAS-only path.
   ========================================================================= */

%macro crf_rules_to_sas(rules=, sheet=, code=);

  /* --- 1. read and normalise the rules sheet --------------------------- */
  proc import datafile="&rules." out=_crf_meta dbms=xlsx replace;
    sheet="&sheet.";
    getnames=yes;
  run;

  data _crf_meta;
    set _crf_meta;
    length var $32 fcode $40 kind $4 rule_sas $1000 msg $300;
    var   = strip(variable);
    if missing(var) or var =: '#' then delete;   /* scanner metadata rows */
    fcode = compress(format);
    if upcase(fcode) = 'YYMMDD' then do;
      kind = 'date'; maxlen = 8;
    end;
    else if prxmatch('/N\(\d+(-\d+)?\)/', fcode) then do;
      kind = 'num';
      maxlen = input(prxchange('s/.*N\((\d+-)?(\d+)\).*/$2/', 1, fcode), 8.);
    end;
    else if prxmatch('/X\(\d+(-\d+)?\)/', fcode) then do;
      kind = 'char';
      maxlen = input(prxchange('s/.*X\((\d+-)?(\d+)\).*/$2/', 1, fcode), 8.);
    end;
    else do;
      kind = 'char'; maxlen = 200;
      put "WARNING: unknown format code for " var "- read as text: " format;
    end;
    if not missing(rule) then rule_sas = tranwrd(strip(rule), '#', strip(var));
    msg = coalescec(strip(message), 'rule violated');
  run;

  data _crf_meta;
    set _crf_meta;
    pos = _n_;               /* position of the field in the raw export */
  run;

  proc sql noprint;
    select count(*) into :_crf_n trimmed from _crf_meta;
    select var into :_crf_id trimmed from _crf_meta where pos = 1;
  quit;

  /* --- 2. header and raw import ---------------------------------------- */
  data _null_;
    file "&code." lrecl=2000;
    length line $2000 pct $1;
    pct = '%';   /* keeps macro keywords out of the source of this macro */
    line = '/* GENERATED by crf_rule_engine.sas from ' || "&rules." || ' - edit the Excel sheet, not this file */'; link w;
    line = pct || 'macro crf_clean(raw=, outlib=work, outdir=);'; link w;
    line = 'data _crf_raw;'; link w;
    line = '  infile "&raw." dlm="|" dsd truncover firstobs=2 lrecl=32767;'; link w;
    line = "  length _r1-_r&_crf_n. $200;"; link w;
    line = "  input _r1-_r&_crf_n.;"; link w;
    line = 'run;'; link w;
    line = 'data _crf_typed(drop=_r: variable value type rule message)'; link w;
    line = "     _crf_fmt(keep=&_crf_id. variable value type rule message);"; link w;
    line = '  set _crf_raw;'; link w;
    line = '  length variable $32 value $200 type $6 rule $500 message $200;'; link w;
    line = '  _n_fmt = 0;'; link w;
    stop;
  w: len = lengthn(line); put line $varying2000. len; return;
  run;

  /* --- 3. one conversion block per field -------------------------------- */
  data _null_;
    file "&code." lrecl=2000 mod;
    set _crf_meta;
    length line $2000 v $32 r $8 m $8 setfmt $300;
    v = strip(var);
    r = '_r' || strip(put(pos, 8.));
    m = strip(put(maxlen, 8.));
    setfmt = 'variable="' || strip(v) || '"; value=' || strip(r) || '; type="format"; rule='
           || "'" || tranwrd(strip(format), "'", "''") || "';";
    if kind = 'num' then do;
      line = '  ' || strip(v) || ' = input(strip(' || strip(r) || '), ?? best32.);'; link w;
      line = '  if not missing(' || strip(r) || ') and missing(' || strip(v) || ') then do;'; link w;
      line = '    ' || strip(setfmt) || ' message="not numeric"; _n_fmt + 1; output _crf_fmt;'; link w;
      line = '  end;'; link w;
      line = '  else if length(scan(strip(' || strip(r) || "), 1, '.')) > " || strip(m) || ' then do;'; link w;
      line = '    ' || strip(setfmt) || ' message="more than ' || strip(m) || ' digits"; _n_fmt + 1; output _crf_fmt;'; link w;
      line = '  end;'; link w;
    end;
    else if kind = 'date' then do;
      line = '  ' || strip(v) || ' = input(strip(' || strip(r) || '), ?? yymmdd8.);'; link w;
      line = '  format ' || strip(v) || ' yymmdd10.;'; link w;
      line = '  if not missing(' || strip(r) || ') and missing(' || strip(v) || ') then do;'; link w;
      line = '    ' || strip(setfmt) || ' message="not a valid date (YYYYMMDD)"; _n_fmt + 1; output _crf_fmt;'; link w;
      line = '  end;'; link w;
    end;
    else do;
      line = '  length ' || strip(v) || ' $' || strip(m) || ';'; link w;
      line = '  ' || strip(v) || ' = strip(' || strip(r) || ');'; link w;
      line = '  if length(strip(' || strip(r) || ')) > ' || strip(m) || ' then do;'; link w;
      line = '    ' || strip(setfmt) || ' message="text longer than ' || strip(m) || ' characters"; _n_fmt + 1; output _crf_fmt;'; link w;
      line = '  end;'; link w;
    end;
    return;
  w: len = lengthn(line); put line $varying2000. len; return;
  run;

  /* --- 4. one IF block per rule ----------------------------------------- */
  data _null_;
    file "&code." lrecl=2000 mod;
    length line $2000;
    line = '  output _crf_typed;'; link w;
    line = 'run;'; link w;
    line = 'data &outlib..cleaned(drop=variable value type rule message _n_fmt)'; link w;
    line = "     _crf_rules(keep=&_crf_id. variable value type rule message);"; link w;
    line = '  set _crf_typed;'; link w;
    line = '  length variable $32 value $200 type $6 rule $500 message $200;'; link w;
    line = '  _n_errors = _n_fmt;'; link w;
    stop;
  w: len = lengthn(line); put line $varying2000. len; return;
  run;

  data _null_;
    file "&code." lrecl=2000 mod;
    set _crf_meta(where=(not missing(rule_sas)));
    length line $2000;
    line = '  if not (' || strip(rule_sas) || ') then do;'; link w;
    line = '    _n_errors = _n_errors + 1; variable="' || strip(var) || '"; value=strip(vvalue(' || strip(var) || ')); type="rule";'; link w;
    line = "    rule='" || tranwrd(strip(rule_sas), "'", "''") || "'; message='"
           || tranwrd(strip(msg), "'", "''") || "'; output _crf_rules;"; link w;
    line = '  end;'; link w;
    return;
  w: len = lengthn(line); put line $varying2000. len; return;
  run;

  /* --- 5. footer: findings table, summary, export ------------------------ */
  data _null_;
    file "&code." lrecl=2000 mod;
    length line $2000 pct $1;
    pct = '%';
    line = '  output &outlib..cleaned;'; link w;
    line = 'run;'; link w;
    line = 'data &outlib..findings; set _crf_fmt _crf_rules; run;'; link w;
    line = "proc sort data=&outlib..findings; by &_crf_id. type variable; run;"; link w;
    line = 'proc sql;'; link w;
    line = '  create table &outlib..summary as'; link w;
    line = '  select count(*) as records, sum(_n_errors = 0) as records_without_findings,'; link w;
    line = '         sum(_n_errors > 0) as records_with_findings,'; link w;
    line = '         calculated records_with_findings / calculated records * 100 as pct_with_findings format=5.1'; link w;
    line = '  from &outlib..cleaned;'; link w;
    line = 'quit;'; link w;
    line = pct || 'if ' || pct || 'length(&outdir.) ' || pct || 'then ' || pct || 'do;'; link w;
    line = '  ods excel file="&outdir./plausibility_report.xlsx" options(sheet_name="summary" frozen_headers="on");'; link w;
    line = '  proc print data=&outlib..summary noobs; run;'; link w;
    line = '  ods excel options(sheet_name="findings" autofilter="all" frozen_headers="on");'; link w;
    line = '  proc print data=&outlib..findings noobs; run;'; link w;
    line = '  ods excel close;'; link w;
    line = '  proc export data=&outlib..cleaned outfile="&outdir./cleaned.csv" dbms=csv replace; run;'; link w;
    line = pct || 'end;'; link w;
    line = 'proc datasets lib=work nolist; delete _crf_:; quit;'; link w;
    line = pct || 'mend crf_clean;'; link w;
    stop;
  w: len = lengthn(line); put line $varying2000. len; return;
  run;

  %put NOTE: crf_rule_engine: &_crf_n. fields read from &rules. - program written to &code.;
%mend crf_rules_to_sas;
